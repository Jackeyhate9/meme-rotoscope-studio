# ==============================================================================
# MemeMorph Studio (Meme-Rotoscope-Studio) - 环境与大模型 API 配置模板
# 复制本文件为 .env 或 backend/.env 即可启用对应功能
# 注意：项目内置完善的高保真 Mock 兜底，不配置任何 API Key 亦可完整体验全部前端与工作台链路！
# ==============================================================================

# ----------------- 基础服务配置 -----------------
PROJECT_NAME="MemeMorph Studio Backend API"
VERSION="0.2.0"
ENVIRONMENT="development"
# 存储目录 (默认自动挂载至项目内 storage 目录，亦可配置为对象存储或独立盘路径)
# STORAGE_DIR="./storage"

# ----------------- 1. 本地工业级 Hypit 引擎 (FastVideo v2 / H3) -----------------
# 拥有本地大显存 GPU (RTX 3090/4090/5090) 时，配置 Hypit 仓库根目录即可启用 0 算力本地离线出片
# HYPIT_HOME="D:/AI/gongzuoliu/clone video"

# ----------------- 2. 字节跳动 Seedance (SEED 2.5 / 火山方舟) -----------------
# 注册并申请火山引擎方舟平台大模型访问权限: https://www.volcengine.com/product/ark
# VOLCENGINE_ACCESS_KEY="your_volcengine_access_key"
# VOLCENGINE_SECRET_KEY="your_volcengine_secret_key"
# VOLCENGINE_ENDPOINT="https://ark.cn-beijing.volces.com/api/v3"
# VOLCENGINE_MODEL_ENDPOINT_ID="ep-2026xxxxxx-xxxx"

# ----------------- 3. 快手可灵 Kling AI (可灵 1.5 / 2.0 电影版) -----------------
# 申请快手可灵开发者开放平台 API: https://api.klingai.com/
# KLING_API_KEY="your_kling_api_key_here"
# KLING_ENDPOINT="https://api.klingai.com/v1"

# ----------------- 4. MiniMax 海螺视频 (Video-01) -----------------
# 申请 MiniMax 开放平台大模型凭证: https://api.minimax.chat/
# MINIMAX_API_KEY="your_minimax_api_key_here"
# MINIMAX_GROUP_ID="your_minimax_group_id_here"
# MINIMAX_ENDPOINT="https://api.minimax.chat/v1"

# ----------------- 5. 视觉多模态 Auto-QC 与 Agent 质检模型 -----------------
# 用于分镜连贯性、人脸一致性评分与人机协同裁决 (支持 OpenAI / OneAPI / DeepSeek / 各种兼容端点)
# OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
# OPENAI_BASE_URL="https://api.openai.com/v1"
